ExternalProject_Add(
  sdl3-image
  DEPENDS libjpeg
          libjxl
          libpng
          libwebp
          sdl3
          zlib
  URL https://github.com/libsdl-org/SDL_image/releases/download/release-3.4.8/SDL3_image-3.4.8.tar.gz
  URL_HASH SHA256=e8223b424bc7541cf84ffff5cf7e4f24ec3711c60462cb1bd6dc1d7bd7f25477
  DOWNLOAD_EXTRACT_TIMESTAMP 1
  CONFIGURE_COMMAND
    ${EXEC} cmake -H<SOURCE_DIR> -B<BINARY_DIR>
    ${cmake_conf_args}
    -DSDLIMAGE_AVIF=OFF
    -DSDLIMAGE_BACKEND_STB=OFF
    -DSDLIMAGE_DEPS_SHARED=OFF
    -DSDLIMAGE_INSTALL=ON
    -DSDLIMAGE_INSTALL_CPACK=OFF
    -DSDLIMAGE_INSTALL_MAN=OFF
    -DSDLIMAGE_JPG=ON
    -DSDLIMAGE_JXL=ON
    -DSDLIMAGE_PNG=ON
    -DSDLIMAGE_PNG_LIBPNG=ON
    -DSDLIMAGE_SAMPLES=OFF
    -DSDLIMAGE_STRICT=ON
    -DSDLIMAGE_TESTS=OFF
    -DSDLIMAGE_TIF=OFF
    -DSDLIMAGE_VENDORED=OFF
    -DSDLIMAGE_WEBP=ON
    -DSDLIMAGE_WERROR=OFF
  BUILD_COMMAND ${NINJA} -C <BINARY_DIR>
  INSTALL_COMMAND ${NINJA} install
  LOG_DOWNLOAD 1
  LOG_UPDATE 1
  LOG_CONFIGURE 1
  LOG_BUILD 1
  LOG_INSTALL 1)
