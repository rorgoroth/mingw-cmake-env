ExternalProject_Add(
  sdl3-mixer
  DEPENDS flac
          ogg
          sdl3
          vorbis
  URL https://github.com/libsdl-org/SDL_mixer/releases/download/release-3.2.4/SDL3_mixer-3.2.4.tar.gz
  URL_HASH SHA256=182a07c745375e113dc740d43964ff21b0be29f29f59876c4dbc4db3d32f6901
  DOWNLOAD_EXTRACT_TIMESTAMP 1
  CONFIGURE_COMMAND
    ${EXEC} cmake -H<SOURCE_DIR> -B<BINARY_DIR>
    ${cmake_conf_args}
    -DSDLMIXER_DEPS_SHARED=OFF
    -DSDLMIXER_EXAMPLES=OFF
    -DSDLMIXER_FLAC=ON
    -DSDLMIXER_FLAC_DRFLAC=OFF
    -DSDLMIXER_FLAC_LIBFLAC=ON
    -DSDLMIXER_GME=OFF
    -DSDLMIXER_INSTALL=ON
    -DSDLMIXER_INSTALL_CPACK=OFF
    -DSDLMIXER_INSTALL_MAN=OFF
    -DSDLMIXER_MIDI=ON
    -DSDLMIXER_MIDI_FLUIDSYNTH=OFF
    -DSDLMIXER_MIDI_TIMIDITY=ON
    -DSDLMIXER_MOD=OFF
    -DSDLMIXER_MP3=ON
    -DSDLMIXER_MP3_DRMP3=ON
    -DSDLMIXER_MP3_MPG123=OFF
    -DSDLMIXER_OPUS=OFF
    -DSDLMIXER_STRICT=ON
    -DSDLMIXER_TESTS=OFF
    -DSDLMIXER_VENDORED=OFF
    -DSDLMIXER_VORBIS_STB=OFF
    -DSDLMIXER_VORBIS_TREMOR=OFF
    -DSDLMIXER_VORBIS_VORBISFILE=ON
    -DSDLMIXER_WAVPACK=OFF
    -DSDLMIXER_WERROR=OFF
  BUILD_COMMAND ${NINJA} -C <BINARY_DIR>
  INSTALL_COMMAND ${NINJA} install
  LOG_DOWNLOAD 1
  LOG_UPDATE 1
  LOG_CONFIGURE 1
  LOG_BUILD 1
  LOG_INSTALL 1)
