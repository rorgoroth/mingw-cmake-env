ExternalProject_Add(
  expat
  URL https://github.com/libexpat/libexpat/releases/download/R_2_10_0/expat-2.10.0.tar.bz2
  URL_HASH SHA256=44e0139015f1c9908d0876b5516235136f16b14932d8f6634a16737a12742f53
  DOWNLOAD_EXTRACT_TIMESTAMP 1
  CONFIGURE_COMMAND
    ${EXEC} cmake -H<SOURCE_DIR> -B<BINARY_DIR>
    ${cmake_conf_args}
    -DEXPAT_BUILD_DOCS=OFF
    -DEXPAT_BUILD_EXAMPLES=OFF
    -DEXPAT_BUILD_FUZZERS=OFF
    -DEXPAT_BUILD_PKGCONFIG=ON
    -DEXPAT_BUILD_TESTS=OFF
    -DEXPAT_BUILD_TOOLS=OFF
    -DEXPAT_CHAR_TYPE=char
    -DEXPAT_ENABLE_INSTALL=ON
    -DEXPAT_OSSFUZZ_BUILD=OFF
    -DEXPAT_SHARED_LIBS=OFF
    -DEXPAT_WARNINGS_AS_ERRORS=OFF
    -DEXPAT_WITH_GETRANDOM=AUTO
    -DEXPAT_WITH_SYS_GETRANDOM=AUTO
  BUILD_COMMAND ${NINJA} -C <BINARY_DIR>
  INSTALL_COMMAND ${NINJA} -C <BINARY_DIR> install
  LOG_DOWNLOAD 1
  LOG_UPDATE 1
  LOG_CONFIGURE 1
  LOG_BUILD 1
  LOG_INSTALL 1)

