[binaries]
c = '@CMAKE_INSTALL_PREFIX@/bin/x86_64-w64-mingw32-gcc'
cpp = '@CMAKE_INSTALL_PREFIX@/bin/x86_64-w64-mingw32-g++'
ar = '@CMAKE_INSTALL_PREFIX@/bin/x86_64-w64-mingw32-ar'
as = '@CMAKE_INSTALL_PREFIX@/bin/x86_64-w64-mingw32-as'
strip = '@CMAKE_INSTALL_PREFIX@/bin/x86_64-w64-mingw32-strip'
windres = '@CMAKE_INSTALL_PREFIX@/bin/x86_64-w64-mingw32-windres'
pkgconfig = '@CMAKE_INSTALL_PREFIX@/bin/x86_64-w64-mingw32-pkg-config'
dlltool = '@CMAKE_INSTALL_PREFIX@/bin/x86_64-w64-mingw32-dlltool'
nasm = 'nasm'
# exe_wrapper = 'wine'

[host_machine]
system = 'windows'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[built-in options]
# Set explicitly so optimisation does not depend on meson reading CFLAGS from
# the environment when cross compiling (buildtype=plain adds no -O level).
c_args = ['-march=@CPUTUNE@', '-@OPTIM@', '-fdata-sections', '-ffunction-sections', '-fvisibility=hidden', '-fno-math-errno']
cpp_args = ['-march=@CPUTUNE@', '-@OPTIM@', '-fdata-sections', '-ffunction-sections', '-fvisibility=hidden', '-fno-math-errno']
c_link_args = ['-fuse-ld=lld', '-@OPTIM@', '-flto-jobs=@CPU_COUNT@', '-Wl,--lto-@OPTIM@', '-Wl,--gc-sections', '-Wl,--icf=safe', '-Wl,--thinlto-cache-dir=@MINGW_INSTALL_PREFIX@/ltocache', '-Wl,--thinlto-cache-policy=cache_size_bytes=500M:prune_interval=1m']
cpp_link_args = ['-fuse-ld=lld', '-@OPTIM@', '-flto-jobs=@CPU_COUNT@', '-Wl,--lto-@OPTIM@', '-Wl,--gc-sections', '-Wl,--icf=safe', '-Wl,--thinlto-cache-dir=@MINGW_INSTALL_PREFIX@/ltocache', '-Wl,--thinlto-cache-policy=cache_size_bytes=500M:prune_interval=1m']
b_ndebug = 'true'
b_lto = true
b_lto_mode = 'thin'
